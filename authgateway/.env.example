DATABASE_URL=postgresql://authgateway:authgateway@localhost:5432/authgateway

# 公司 SSO（人類呼叫用），demo 時指向 mock_sso
SSO_ISSUER=http://localhost:9000
SSO_JWKS_URL=http://localhost:9000/.well-known/jwks.json
SSO_AUDIENCE=authgateway

# AuthGateway 自己簽發 system token 用的 issuer 識別字串
OWN_ISSUER=http://localhost:8000
PRIVATE_KEY_PATH=./keys/private.pem
PUBLIC_KEY_PATH=./keys/public.pem
KEY_ID=authgateway-key-1

ACCESS_TOKEN_TTL_SECONDS=1800

# /admin/* 管理權限：兩種任一通過即可，留空 ADMIN_API_KEY 就停用那個後門
ADMIN_API_KEY=demo-admin-api-key
ADMIN_USER_IDS=bob
